{
 "apps": [
  {
   "id": "launcher",
   "repo": "LibreHU/LibreHU-Launcher-App",
   "tag": "latest-librehu-service",
   "pkg": "org.librehu.launcher",
   "steps": [
    [
     "launch",
     8
    ],
    [
     "shot",
     "onboarding"
    ],
    [
     "tap",
     "^Passer$"
    ],
    [
     "wait",
     2
    ],
    [
     "tap",
     "^Passer$"
    ],
    [
     "tap",
     "^Passer$"
    ],
    [
     "tap",
     "^Passer$"
    ],
    [
     "tap",
     "^Passer$"
    ],
    [
     "tap",
     "^Passer$"
    ],
    [
     "tap",
     "^Terminer$"
    ],
    [
     "home"
    ],
    [
     "wait",
     4
    ],
    [
     "shot",
     "home"
    ]
   ]
  },
  {
   "id": "service",
   "repo": "LibreHU/LibreHU-service",
   "tag": "latest-main",
   "pkg": "org.librehu.service",
   "steps": [
    [
     "launch",
     10
    ],
    [
     "shot",
     "home"
    ],
    [
     "tap",
     "^Véhicule$"
    ],
    [
     "shot",
     "vehicle"
    ],
    [
     "tap",
     "^Audio$"
    ],
    [
     "shot",
     "audio"
    ],
    [
     "tap",
     "^Bluetooth$"
    ],
    [
     "shot",
     "bluetooth"
    ],
    [
     "tap",
     "^Écran$"
    ],
    [
     "shot",
     "display"
    ],
    [
     "tap",
     "^Lumières$"
    ],
    [
     "shot",
     "lights"
    ],
    [
     "tap",
     "^Système$"
    ],
    [
     "shot",
     "system"
    ],
    [
     "tap",
     "^Avancé$"
    ],
    [
     "shot",
     "advanced"
    ]
   ],
   "api": 30
  },
  {
   "id": "dialer",
   "repo": "LibreHU/LibreHU-dialer-app",
   "tag": "latest-librehu-service",
   "pkg": "org.librehu.dialer",
   "steps": [
    [
     "launch",
     6
    ],
    [
     "shot",
     "favorites"
    ],
    [
     "tap",
     "^Récents$"
    ],
    [
     "shot",
     "recents"
    ],
    [
     "tap",
     "^Contacts$"
    ],
    [
     "shot",
     "contacts"
    ],
    [
     "tap",
     "^Clavier$"
    ],
    [
     "shot",
     "keypad"
    ],
    [
     "tap",
     "^Réglages$"
    ],
    [
     "shot",
     "settings"
    ]
   ]
  },
  {
   "id": "fm",
   "repo": "LibreHU/LibreHU-FM-app",
   "tag": "latest-librehu-service",
   "pkg": "org.librehu.fm",
   "steps": [
    [
     "launch",
     8
    ],
    [
     "shot",
     "main"
    ]
   ],
   "api": 30
  },
  {
   "id": "widgets",
   "repo": "LibreHU/LibreHU-widget-app",
   "tag": "latest-librehu-service",
   "pkg": "org.librehu.widgets",
   "steps": [
    [
     "launch",
     6
    ],
    [
     "shot",
     "main"
    ]
   ]
  },
  {
   "id": "btnremap",
   "repo": "LibreHU/LibreHU-BtnRemap-app",
   "tag": "latest-librehu-service",
   "pkg": "org.librehu.btnremap",
   "steps": [
    [
     "launch",
     6
    ],
    [
     "shot",
     "main"
    ]
   ]
  },
  {
   "id": "easysource",
   "repo": "LibreHU/LibreHU-EasySource-app",
   "tag": "latest-main",
   "pkg": "org.librehu.easysource",
   "steps": [
    [
     "launch",
     6
    ],
    [
     "shot",
     "settings"
    ],
    [
     "tap",
     "^Changer de source$"
    ],
    [
     "wait",
     1
    ],
    [
     "shot",
     "switcher"
    ]
   ]
  },
  {
   "id": "ota",
   "repo": "LibreHU/LibreHU-OTA-app",
   "tag": "latest-main",
   "pkg": "org.librehu.ota",
   "steps": [
    [
     "launch",
     10
    ],
    [
     "shot",
     "apps"
    ],
    [
     "tap",
     "^Versions$"
    ],
    [
     "wait",
     5
    ],
    [
     "shot",
     "versions"
    ],
    [
     "back"
    ],
    [
     "tap",
     "^Journal$"
    ],
    [
     "wait",
     5
    ],
    [
     "shot",
     "logs"
    ]
   ],
   "grant": [
    "android.permission.READ_LOGS"
   ]
  },
  {
   "id": "viper",
   "repo": "LibreHU/LibreHU-ViPER4Android-app",
   "tag": "latest-librehu-service",
   "pkg": "com.llsl.viper4android",
   "steps": [
    [
     "launch",
     6
    ],
    [
     "shot",
     "main"
    ]
   ]
  },
  {
   "id": "mcu",
   "repo": "LibreHU/MCU-tools-app",
   "tag": "latest-main",
   "pkg": "com.dokt.jacmcu",
   "steps": [
    [
     "launch",
     8
    ],
    [
     "shot",
     "main"
    ]
   ],
   "api": 30
  }
 ]
}