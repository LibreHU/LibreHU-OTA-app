<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Root asked for every LibreHU app at once (LibreHU Launcher): requests and answers between apps signed with
         the LibreHU key only. Defined by every LibreHU app, so that it exists whatever the install order. -->
    <permission
        android:name="org.librehu.permission.ROOT_REQUEST"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.librehu.permission.ROOT_REQUEST" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network present or not (list kept offline, check again when it comes back). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Without root: Android's package installer, the user confirms each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Daily check (CheckJob), scheduled again after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Downloads and installs (also from the background check) in a foreground service until they end. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Logs of the other apps without root: granted from a computer, adb shell pm grant org.librehu.ota android.permission.READ_LOGS. -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+: the catalogue (catalog.json) can name any app; without this, those missing from <queries> below
         would look not installed. Not sold in a store: no store policy applies. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <package android:name="org.librehu.service" />
        <package android:name="org.librehu.launcher" />
        <package android:name="org.librehu.dialer" />
        <package android:name="org.librehu.fm" />
        <package android:name="org.librehu.widgets" />
        <package android:name="org.librehu.btnremap" />
        <package android:name="org.librehu.easysource" />
        <package android:name="com.llsl.viper4android" />
        <package android:name="com.dokt.jacmcu" />
        <package android:name="org.librehu.disc" />
        <package android:name="org.librehu.helper" />
        <package android:name="org.librehu.headunit" />
        <package android:name="org.librehu.carplay" />
        <!-- Root managers: official KernelSU 3+ needs a metamodule to change /system, KernelSU Next does not. -->
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
    </queries>

    <!-- LibreHU apps (same signing key): LibreHU-service's bridge reads and changes this app's settings for the phone app. -->
    <permission
        android:name="org.librehu.permission.BRIDGE"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibreHU.Car">
        <!-- Single-colour icon: LibreHU Launcher draws it in the colours of its theme. -->
        <meta-data
            android:name="org.librehu.themed_icon"
            android:resource="@drawable/ic_launcher_mono" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".TransferActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".install.InstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".CheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Native compilation a minute after a start, without LibreHU-service (install/AppCompiler.kt). -->
        <service
            android:name=".install.CompileJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- LibreHU Launcher's first start: root asked for every LibreHU app at once (RootRequestReceiver). -->
        <receiver
            android:name=".RootRequestReceiver"
            android:exported="true"
            android:permission="org.librehu.permission.ROOT_REQUEST">
            <intent-filter>
                <action android:name="org.librehu.action.REQUEST_ROOT" />
            </intent-filter>
        </receiver>
        <!-- Settings pages for LibreHU's phone app, read and changed by LibreHU-service's bridge (.bridge.BridgeProvider). -->
        <provider
            android:name=".bridge.BridgeProvider"
            android:authorities="org.librehu.ota.bridge"
            android:exported="true"
            android:permission="org.librehu.permission.BRIDGE" />
    </application>
</manifest>
