<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Without root: Android's package installer, the user confirms each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Daily check (CheckJob), scheduled again after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Logs of the other apps without root: granted from a computer, adb shell pm grant org.librehu.ota android.permission.READ_LOGS. -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <package android:name="org.librehu.service" />
        <package android:name="org.librehu.launcher" />
        <package android:name="org.librehu.dialer" />
        <package android:name="org.librehu.fm" />
        <package android:name="org.librehu.widgets" />
        <package android:name="org.librehu.btnremap" />
        <package android:name="org.librehu.easysource" />
        <package android:name="com.llsl.viper4android" />
        <package android:name="com.dokt.jacmcu" />
        <!-- Root managers: official KernelSU 3+ needs a metamodule to change /system, KernelSU Next does not. -->
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibreHU.Car">
        <!-- Single-colour icon: LibreHU Launcher draws it in the colours of its theme. -->
        <meta-data
            android:name="org.librehu.themed_icon"
            android:resource="@drawable/ic_launcher_mono" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".install.InstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".CheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
